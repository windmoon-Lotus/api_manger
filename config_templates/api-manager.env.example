# Runtime data must be outside the Git repository.
API_MANAGER_DATA_DIR=/path/outside/repository/authcheck-data

# Optional local Web configuration. Omit these values to let first-run
# bootstrap generate a private credential file outside the repository.
API_MANAGER_ADMIN_USERNAME=admin
# API_MANAGER_ADMIN_PASSWORD=example-password
# API_MANAGER_SECRET_KEY=example-secret-key

API_MANAGER_MONGO_HOST=127.0.0.1
API_MANAGER_MONGO_PORT=27017
API_MANAGER_MONGO_DATABASE=apihandl
API_MANAGER_REDIS_HOST=127.0.0.1
API_MANAGER_REDIS_PORT=6379

# Optional trusted-tool token for the in-process MFA push receiver API.
# Generate a random value and keep it outside Git.
# API_MANAGER_MFA_RECEIVER_TOKEN=replace-with-random-token
# Optional cross-process push broker. Web and execution workers must use the same values.
# API_MANAGER_MFA_RECEIVER_REDIS_URL=redis://127.0.0.1:6379/2
