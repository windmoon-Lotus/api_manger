{
  "schema_version": "rule.v1",
  "rule_id": "resource.endpoint.parent_child_chain",
  "version": 1,
  "kind": "offline_inference",
  "enabled": true,
  "scope": {"same_project": true, "same_environment": true, "principal_relation": "any"},
  "inputs": ["resource_chain"],
  "predicates": [{"name": "resource_chain.eligible.v1"}],
  "score": {"base": 0.0, "features": [{"predicate": "resource_chain.confidence.v1", "weight": 1.0}]},
  "emit": {"adapter": "resource_chain_candidate.v1"},
  "safety": {"network": "forbidden", "mutation": "forbidden", "max_matches": 50000}
}
